config PROSPECTOR_LAYER_ROLLER_ALL_CAPS
    bool "Convert layer names to all caps"
    default n

config PROSPECTOR_ROTATE_DISPLAY_180
    bool "Rotate the display 180 degrees"
    default n

config PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR
    bool "Use ambient light sensor for auto brightness"
    default y

config PROSPECTOR_FIXED_BRIGHTNESS
    int "Fixed display brightness"
    default 50
    range 1 100
    depends on !PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR
config PROSPECTOR_WPM_PANEL
    bool "Show a words-per-minute panel (number + history graph)"
    default y
    depends on ZMK_WPM
    select LV_USE_CHART

config PROSPECTOR_ACTIVE_LAYER_Y
    int "Vertical offset of the active layer name from the screen center"
    default -42 if PROSPECTOR_WPM_PANEL
    default -20
    help
      Read-only layout value for code that places its own objects level with
      the active layer (e.g. extra indicators added from a user config).

config PROSPECTOR_ZAPPY_BIRDS
    bool "Zappy Birds: hidden tap-to-fly game on the dongle screen"
    default n
    depends on SHIELD_PROSPECTOR_ADAPTER
    select LV_USE_LABEL
    select LV_USE_LINE
    select LV_USE_FLEX
    help
      Adds the &zappy (toggle game mode) and &zflap (flap) behaviors and the
      game screen. Pair with a keymap layer of &zflap bindings.

config PROSPECTOR_ROLLER_HIDDEN_TRAILING_LAYERS
    int "Number of trailing keymap layers to hide from the layer roller"
    range 0 8
    default 1 if PROSPECTOR_ZAPPY_BIRDS
    default 0
